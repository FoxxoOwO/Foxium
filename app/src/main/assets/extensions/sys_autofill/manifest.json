{
  "manifest_version": 2,
  "name": "Foxium Autofill",
  "version": "1.0.0",
  "description": "Fills saved addresses and payment cards into page forms.",
  "browser_specific_settings": {
    "gecko": {
      "id": "sys_autofill@chrogecko.browser",
      "strict_min_version": "128.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "permissions": [
    "nativeMessaging",
    "geckoViewAddons",
    "tabs"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  }
}
